{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unstory",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "cfbc7936-17d6-4e1e-a70d-fe6297017c1e",
      "database_name": "unstory",
      "migrations_dir": "drizzle"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "cfbc7936-17d6-4e1e-a70d-fe6297017c1e",
      "database_name": "unstory"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "unstory"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "unstory"
    }
  ],
  // route domain 
  "routes": [
    {
      "pattern": "unstory.app/*",
      "zone_name": "unstory.app"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTENT_QUEUE",
        "queue": "unstory-content-queue"
      }
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://unstory.app",
    "ADMIN_PASSWORD": "PLACEHOLDER_CHANGE_ME",
    "PAYLOAD_SECRET": "32_CHARACTERS_OF_RANDOMNESS_GOES_HERE_CHANGE_ME"
  }
}
